{
  "name": "mihon-website",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "Official website for the Mihon app.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mihonapp/website.git"
  },
  "bugs": {
    "url": "https://github.com/mihonapp/website/issues"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test": "pnpm lint && pnpm build",
    "dev": "vitepress dev src",
    "build": "vitepress build src",
    "preview": "vitepress preview src",
    "lint": "pnpm lint:es && pnpm lint:mdl && pnpm lint:style",
    "lint:fix": "pnpm lint:es:fix && pnpm lint:style:fix",
    "lint:es": "eslint . ",
    "lint:es:fix": "eslint . --fix",
    "lint:mdl": "markdownlint \"**/*.md\" \".github/**/*.md\" --enable sentences-per-line --disable MD025 MD033",
    "lint:style": "cross-env NODE_OPTIONS='--no-deprecation' stylelint '**/*.{styl,vue}' 'src/.vitepress/**/*.{styl,vue}'",
    "lint:style:fix": "cross-env NODE_OPTIONS='--no-deprecation' stylelint --fix '**/*.{styl,vue}' 'src/.vitepress/**/*.{styl,vue}'",
    "refresh:releases": "node --experimental-strip-types src/.vitepress/config/releaseData.ts"
  },
  "dependencies": {
    "@iconify-prerendered/vue-mdi": "0.28.1737398331",
    "@octokit/rest": "22.0.1",
    "@octokit/types": "17.0.0",
    "@tanstack/vue-query": "5.102.8",
    "@vueuse/core": "14.4.0",
    "axios": "1.20.0",
    "element-plus": "2.14.5",
    "lodash.groupby": "4.6.0",
    "luxon": "^3.7.2",
    "markdown-it": "15.0.1",
    "markdown-it-shortcode-tag": "1.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@eslint/eslintrc": "^3.3.6",
    "@mdit/plugin-attrs": "1.3.0",
    "@mdit/plugin-figure": "1.2.0",
    "@mdit/plugin-img-lazyload": "1.1.0",
    "@mdit/plugin-img-mark": "1.1.0",
    "@mdit/plugin-img-size": "1.1.0",
    "@mdit/plugin-include": "1.1.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/gtag.js": "0.0.20",
    "@types/lodash.groupby": "4.6.9",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.4.0",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "cross-env": "^10.1.0",
    "eslint": "10.9.1",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-vue": "10.10.0",
    "feed": "6.0.0",
    "lint-staged": "17.4.1",
    "markdownlint": "0.41.1",
    "markdownlint-cli": "0.49.1",
    "sentences-per-line": "0.5.3",
    "stylelint": "17.14.1",
    "stylelint-stylus": "1.0.0",
    "stylus": "0.64.0",
    "unplugin-element-plus": "0.11.2",
    "vite-plugin-eslint": "1.8.1",
    "vitepress": "1.6.4",
    "vitepress-plugin-tabs": "0.9.1",
    "vue": "3.5.42",
    "vue-eslint-parser": "10.4.1",
    "x-satori": "0.5.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{styl,vue}": "stylelint --fix",
    "*.{html,json}": "prettier --write"
  }
}
